{
	"name": "recept.tammergard.se",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "astro check && astro build",
		"dev": "astro dev",
		"format": "prettier --write .",
		"format-check": "prettier --check .",
		"preview": "astro preview",
		"review": "pnpm install --frozen-lockfile && pnpm format-check && pnpm build",
		"start": "astro dev"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.2.8",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@tammergard/prettier-config": "^3.0.2",
		"@tammergard/tsconfig": "^3.0.2",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.21.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	}
}
